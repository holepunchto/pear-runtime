{
  "name": "pear-runtime",
  "version": "1.1.3",
  "description": "Embeddable Pear Runtime",
  "license": "Apache-2.0",
  "author": "Holepunch Inc",
  "main": "index.js",
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "package.json",
    "index.js",
    "index.d.ts",
    "lib/"
  ],
  "scripts": {
    "format": "prettier --write .",
    "test": "prettier --check . && lunte",
    "lint": "lunte"
  },
  "imports": {
    "#run": {
      "bare": "./lib/run/bare.js",
      "default": "./lib/run/default.js"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    }
  },
  "dependencies": {
    "bare-channel": "^5.2.4",
    "bare-module": "^6.2.0",
    "bare-path": "^3.0.0",
    "bare-pipe": "^4.1.3",
    "bare-sidecar": "^0.4.5",
    "bare-thread": "^1.2.2",
    "corestore": "^7.9.1",
    "hyperswarm": "^4.17.0",
    "pear-runtime-updater": "^3.0.0",
    "ready-resource": "^1.2.0"
  },
  "devDependencies": {
    "lunte": "^1.6.0",
    "prettier": "^3.8.1",
    "prettier-config-holepunch": "^2.0.0"
  },
  "directories": {
    "example": "examples",
    "lib": "lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/pear-runtime.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/holepunchto/pear-runtime/issues"
  },
  "homepage": "https://github.com/holepunchto/pear-runtime#readme"
}
