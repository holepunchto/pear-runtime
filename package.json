{
  "name": "pear-runtime",
  "version": "0.4.2",
  "description": "Embeddable Pear Runtime",
  "license": "Apache-2.0",
  "author": "Holepunch Inc",
  "main": "index.js",
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "package.json",
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "format": "prettier --write .",
    "test": "prettier --check . && lunte",
    "lint": "lunte"
  },
  "imports": {
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    }
  },
  "dependencies": {
    "bare-sidecar": "^0.3.0",
    "pear-runtime-updater": "^0.0.5"
  },
  "devDependencies": {
    "lunte": "^1.6.0",
    "prettier": "^3.8.1",
    "prettier-config-holepunch": "^2.0.0"
  }
}
